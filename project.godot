lights_and_shadows/positional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=4
lights_and_shadows/positional_shadow/atlas_16_bits=false
lights_and_shadows/tighter_shadow_caster_culling=false
lights_and_shadows/positional_shadow/atlas_size=16384
lights_and_shadows/positional_shadow/atlas_size.mobile=8192
